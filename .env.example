# ── LINGO environment ──────────────────────────────────────────────
# The client reads ONLY this URL. Zero secrets live in the client.
# Point it at the Cloudflare Worker proxy (see worker/ + docs/PROXY.md).
VITE_API_BASE_URL=https://your-worker.your-name.workers.dev

# Optional: enable remote AI features at all (default true when set)
VITE_ENABLE_AI=true
